# Copy this file to ".env" (same folder) and change the values:   copy .env.example .env
# ".env" is ignored by git, so your real passwords are never uploaded.
# On a host (Render etc.) type these into the dashboard "Environment" page instead.

PORT=3000
# On the host set NODE_ENV=production (turns on secure cookies). Leave it out on your own PC.
# NODE_ENV=production

SESSION_SECRET=change-me-to-a-long-random-text
MANAGER_EMAIL=manager@fixline.local
MANAGER_PASSWORD=change-me-strong-password

# Demo accounts + sample issues. true = create them. Password is shared by all demo accounts.
SEED_DEMO=true
DEMO_PASSWORD=change-me-demo-password

# Where the database file is stored
DB_PATH=./data/fixline.db
